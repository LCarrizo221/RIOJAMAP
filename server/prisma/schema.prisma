generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Obra {
  id             Int      @id @default(autoincrement())
  fecha          DateTime
  municipio      String
  referente      String
  concepto       String
  tipo           String
  estado         String
  montoTotal     Float
  montoParcial   Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
